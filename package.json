{
  "name": "@trucee/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Trucee (Zero-PvP curve) client SDK: router accounts, events, instructions, launch preset and quotes",
  "keywords": [
    "solana",
    "meteora",
    "dynamic-bonding-curve",
    "dbc",
    "token-2022",
    "launchpad",
    "trucee"
  ],
  "homepage": "https://docs.trucee.fun/quickstart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trucee-fun/trucee-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/trucee-fun/trucee-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.4",
    "bn.js": "^5.2.5",
    "buffer": "^6.0.3",
    "litesvm": "^0.8.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
